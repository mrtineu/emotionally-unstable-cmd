{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emotionally-unstable-cmd",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  // Static site. Requests that match a file are served directly; everything else (/api/*) hits the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Hall of Fame storage (created with: npx wrangler kv namespace create BOARD)
  "kv_namespaces": [{ "binding": "BOARD", "id": "5a052f51a8bc4e2ebfbb82673f9ff79f" }],
  // Free per-IP rate limit on /api/cmd (protects the Vertex credits). period must be 10 or 60 seconds.
  "ratelimits": [{ "name": "CMD_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true }
  // Secret (not in this file): npx wrangler secret put GOOGLE_SERVICE_ACCOUNT_JSON < gcp-service-account.json
}
