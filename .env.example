# --- AI: configure ONE of these (first match wins). Nothing set = offline drama mode. ---

# Option A (recommended): Vertex AI with a service account. Bills your Google Cloud project, so credits apply.
# Paste the whole service-account key JSON on ONE line (or base64 of it):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com",...}
# ...or, for local dev only, point at the downloaded key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
# VERTEX_PROJECT=my-project-id     # optional, defaults to project_id from the key
# VERTEX_LOCATION=global           # optional, default global

# Option B: Vertex AI API key (express mode)
# VERTEX_API_KEY=

# Option C: Gemini API key from AI Studio (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# Optional: override the model (default gemini-3.5-flash-lite; gemini-3.8-flash is smarter but ~2x slower)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: shared leaderboard (Vercel Marketplace -> Upstash Redis sets these automatically)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
